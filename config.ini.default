; QtFaceAttendance 默认配置模板
;
; 这个文件是"出厂设置"。编译的时候，构建系统会把它复制一份到可执行文件旁边，
; 名字改成 config.ini。程序真正读的是那一份，不是这一份。
;
; 所以：要改配置，去改 exe 旁边那份 config.ini，别改这里。
; 这里只在"目标位置还没有 config.ini"时才被用到。

[client]
; 客户端要连的服务器地址。
; 同一台电脑上测试就写 127.0.0.1；
; 跨电脑测试时写服务端那台机器的局域网地址，比如 192.168.1.23。
server_address=127.0.0.1

; 客户端要连的端口，必须和服务端的 listen_port 一致。
server_port=45454

; 用哪个摄像头。0 一般是笔记本内置摄像头；接了 USB 摄像头通常写 1 或 2。
; 填错不会崩，界面上会提示"摄像头 N 打开失败"。
camera_index=0

[server]
; 服务端在哪个地址上等人来连。
; 127.0.0.1 只接受本机连接；想接受局域网里其他电脑的连接要改成 0.0.0.0。
listen_address=127.0.0.1

; 服务端监听的端口。
listen_port=45454
