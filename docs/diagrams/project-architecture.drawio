  <diagram id="page-flow-frame" name="流程图 · 一帧画面的处理">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1637" pageHeight="3500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f-title" value="流程图 · 一帧画面从摄像头到考勤表" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="42" y="28" width="1120" height="42" as="geometry" /></mxCell>
        <mxCell id="f-n1" value="开始：客户端每 500 毫秒取一帧预览图" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="588" y="98" width="392" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n2" value="编码成 JPEG&lt;br&gt;→ FrameProtocol::pack 加 4 字节长度&lt;br&gt;→ socket 发出去" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="588" y="210" width="392" height="84" as="geometry" /></mxCell>
        <mxCell id="f-n3" value="服务端：字节追加到 receiveBuffer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="588" y="336" width="392" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n4" value="缓冲里够 4 个字节吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="602" y="448" width="364" height="112" as="geometry" /></mxCell>
        <mxCell id="f-wait1" value="继续等&lt;br&gt;（半包是常态）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1078" y="469" width="224" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n5" value="读出长度字段" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="588" y="602" width="392" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n6" value="长度不超过 10 MB？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="602" y="714" width="364" height="112" as="geometry" /></mxCell>
        <mxCell id="f-bad1" value="流已经错位&lt;br&gt;断开这条连接" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1078" y="735" width="224" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n7" value="整帧收齐了吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="602" y="868" width="364" height="112" as="geometry" /></mxCell>
        <mxCell id="f-n8" value="切出一条完整消息&lt;br&gt;发信号给 ServerController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="588" y="1022" width="392" height="84" as="geometry" /></mxCell>
        <mxCell id="f-n9" value="开头是 JPEG 标记吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="602" y="1148" width="364" height="112" as="geometry" /></mxCell>
        <mxCell id="f-text1" value="当文本消息处理&lt;br&gt;记一行日志" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1078" y="1169" width="224" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n10" value="cv::imdecode 解码" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="588" y="1302" width="392" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n11" value="解码成功吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="602" y="1414" width="364" height="112" as="geometry" /></mxCell>
        <mxCell id="f-bad2" value="记一行错误日志" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1078" y="1435" width="224" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n12" value="YuNet 检测，得到 N×15 的表" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="588" y="1568" width="392" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n13" value="检测到人脸吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="602" y="1680" width="364" height="112" as="geometry" /></mxCell>
        <mxCell id="f-n14" value="挑置信度最高的脸&lt;br&gt;→ alignCrop 裁成 112×112&lt;br&gt;→ SFace 提 128 维特征" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="588" y="1834" width="392" height="84" as="geometry" /></mxCell>
        <mxCell id="f-n15" value="与 templates_ 逐条算余弦相似度&lt;br&gt;取最高分" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="588" y="1960" width="392" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n16" value="最高分 ≥ 0.363 吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="602" y="2072" width="364" height="112" as="geometry" /></mxCell>
        <mxCell id="f-n17" value="结果 = 识别成功（姓名）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="588" y="2226" width="392" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n18" value="状态和上一帧一样吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="602" y="2338" width="364" height="112" as="geometry" /></mxCell>
        <mxCell id="f-same" value="这一帧不再处理&lt;br&gt;（否则日志会刷屏）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1078" y="2359" width="238" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n19" value="写一行结果到服务端界面" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="588" y="2492" width="392" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n20" value="认出人了吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="602" y="2604" width="364" height="112" as="geometry" /></mxCell>
        <mxCell id="f-n21" value="120 秒内已经记过吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="602" y="2758" width="364" height="112" as="geometry" /></mxCell>
        <mxCell id="f-skip" value="考勤未记录&lt;br&gt;（120 秒内已记过）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1078" y="2779" width="238" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n22" value="写入 attendance_records&lt;br&gt;check_in + 当时的相似度" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="588" y="2912" width="392" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n23" value="组装 RESULT 消息&lt;br&gt;发回触发这条消息的客户端" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="588" y="3038" width="392" height="84" as="geometry" /></mxCell>
        <mxCell id="f-n24" value="客户端解析，更新界面显示" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="588" y="3164" width="392" height="70" as="geometry" /></mxCell>
        <mxCell id="f-n25" value="结束" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="588" y="3276" width="392" height="70" as="geometry" /></mxCell>
        <mxCell id="f-noface" value="结果 = 未检测到人脸" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1078" y="1701" width="238" height="70" as="geometry" /></mxCell>
        <mxCell id="f-unknown" value="结果 = 未识别" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1078" y="2093" width="238" height="70" as="geometry" /></mxCell>
        <mxCell id="f-e1" value="" style="endArrow=block;html=1;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="f-n1" target="f-n2"><mxGeometry relative="1" as="geometry" /></mxCell>
