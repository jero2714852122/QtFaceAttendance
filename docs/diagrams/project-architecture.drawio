    </mxGraphModel>
  </diagram>

  <diagram id="page-flow-manage" name="流程图 · 员工管理与登记">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1637" pageHeight="2170" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="m-title" value="流程图 · 员工管理与登记人脸（四个流程）" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="42" y="28" width="1120" height="42" as="geometry" /></mxCell>

        <mxCell id="m-h1" value="① 新增员工" style="text;html=1;fontSize=20;fontStyle=1;align=left;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="98" y="84" width="420" height="34" as="geometry" /></mxCell>
        <mxCell id="a1" value="开始：填写工号、姓名、部门" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="98" y="133" width="308" height="70" as="geometry" /></mxCell>
        <mxCell id="a2" value="点「新增员工」&lt;br&gt;发信号 addEmployeeRequested" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="98" y="238" width="308" height="70" as="geometry" /></mxCell>
        <mxCell id="a3" value="去掉字符串两头的空格" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="98" y="343" width="308" height="70" as="geometry" /></mxCell>
        <mxCell id="ad1" value="工号和姓名&lt;br&gt;都填了吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="112" y="448" width="280" height="112" as="geometry" /></mxCell>
        <mxCell id="ab1" value="提示「不能为空」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="504" y="469" width="252" height="70" as="geometry" /></mxCell>
        <mxCell id="ad2" value="工号已经&lt;br&gt;存在了吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="112" y="602" width="280" height="112" as="geometry" /></mxCell>
        <mxCell id="ab2" value="提示「工号 xx 已存在」&lt;br&gt;（前置检查，给用户人话）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="504" y="623" width="252" height="70" as="geometry" /></mxCell>
        <mxCell id="a4" value="INSERT INTO employees&lt;br&gt;数据库唯一约束是最后一道防线" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="98" y="756" width="308" height="70" as="geometry" /></mxCell>
        <mxCell id="a5" value="提示「员工新增成功」&lt;br&gt;刷新列表和计数" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="98" y="861" width="308" height="70" as="geometry" /></mxCell>
