<mxfile host="app.diagrams.net" agent="QtFaceAttendance" version="24.7.17">
  <diagram id="page-architecture" name="系统结构">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1637" pageHeight="1156" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="a-title" value="人脸考勤系统 —— 整体结构" style="text;html=1;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="56" y="28" width="840" height="42" as="geometry" />
        </mxCell>

        <mxCell id="a-client" value="客户端" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#6c8ebf;container=1;collapsible=0;fontStyle=1;fontSize=20;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="56" y="98" width="560" height="686" as="geometry" />
        </mxCell>
        <mxCell id="a-c-ui" value="&lt;b&gt;界面层&lt;/b&gt;&lt;br&gt;MainWindow&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;只管显示和收点击&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2" vertex="1" parent="a-client">
          <mxGeometry x="28" y="63" width="504" height="98" as="geometry" />
        </mxCell>
        <mxCell id="a-c-biz" value="&lt;b&gt;业务层&lt;/b&gt;&lt;br&gt;AttendanceController&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;决定什么时候做什么&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2" vertex="1" parent="a-client">
          <mxGeometry x="28" y="217" width="504" height="98" as="geometry" />
        </mxCell>
        <mxCell id="a-c-low" value="&lt;b&gt;底层&lt;/b&gt;&lt;br&gt;CameraController（摄像头）&lt;br&gt;FaceDetector（画绿框）&lt;br&gt;FrameProcessor（图像变换）&lt;br&gt;NetworkClient（收发）&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;只干技术活，不知道界面&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2" vertex="1" parent="a-client">
          <mxGeometry x="28" y="371" width="504" height="280" as="geometry" />
        </mxCell>

        <mxCell id="a-server" value="服务端" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#82b366;container=1;collapsible=0;fontStyle=1;fontSize=20;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="1022" y="98" width="560" height="686" as="geometry" />
        </mxCell>
        <mxCell id="a-s-ui" value="&lt;b&gt;界面层&lt;/b&gt;&lt;br&gt;ServerWindow&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;表单、列表、日志区&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2" vertex="1" parent="a-server">
          <mxGeometry x="28" y="63" width="504" height="98" as="geometry" />
        </mxCell>
        <mxCell id="a-s-biz" value="&lt;b&gt;业务层&lt;/b&gt;&lt;br&gt;ServerController&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;所有判断都在这里&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2" vertex="1" parent="a-server">
          <mxGeometry x="28" y="217" width="504" height="98" as="geometry" />
        </mxCell>
        <mxCell id="a-s-low" value="&lt;b&gt;底层&lt;/b&gt;&lt;br&gt;Server / ClientConnection（网络）&lt;br&gt;FaceEngine（检测 + 提特征 + 比对）&lt;br&gt;DatabaseManager（数据库连接）&lt;br&gt;EmployeeRepository（员工）&lt;br&gt;FaceTemplateRepository（人脸模板）&lt;br&gt;AttendanceRepository（考勤）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2" vertex="1" parent="a-server">
          <mxGeometry x="28" y="371" width="504" height="280" as="geometry" />
        </mxCell>

        <mxCell id="a-shared" value="&lt;b&gt;两端共用&lt;/b&gt;&lt;br&gt;FrameProtocol&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;4 字节长度 + 内容&lt;br&gt;分帧规则只有这一份&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="672" y="238" width="308" height="154" as="geometry" />
        </mxCell>

        <mxCell id="a-e-signal-c" value="发信号" style="endArrow=open;html=1;dashed=1;strokeColor=#666666;fontColor=#666666;fontSize=17;strokeWidth=3" edge="1" parent="1" source="a-c-ui" target="a-c-biz">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e-call-c" value="直接调用" style="endArrow=block;html=1;strokeColor=#666666;fontColor=#666666;fontSize=17;strokeWidth=3" edge="1" parent="1" source="a-c-biz" target="a-c-ui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e-signal-s" value="发信号" style="endArrow=open;html=1;dashed=1;strokeColor=#666666;fontColor=#666666;fontSize=17;strokeWidth=3" edge="1" parent="1" source="a-s-ui" target="a-s-biz">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e-call-s" value="直接调用" style="endArrow=block;html=1;strokeColor=#666666;fontColor=#666666;fontSize=17;strokeWidth=3" edge="1" parent="1" source="a-s-biz" target="a-s-ui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="a-e-send" value="发：JPEG 帧" style="endArrow=block;html=1;strokeColor=#6c8ebf;fontColor=#6c8ebf;fontSize=17;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="a-c-low" target="a-s-low">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e-reply" value="回：RESULT 结果" style="endArrow=block;html=1;strokeColor=#82b366;fontColor=#82b366;fontSize=17;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="a-s-low" target="a-c-low">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e-shared-c" style="endArrow=none;html=1;dashed=1;strokeColor=#d79b00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="a-shared" target="a-c-low">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-e-shared-s" style="endArrow=none;html=1;dashed=1;strokeColor=#d79b00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="a-shared" target="a-s-low">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="a-legend" value="&lt;b&gt;看图要点&lt;/b&gt;&lt;br&gt;实线箭头 = 业务层往下直接调用&lt;br&gt;虚线箭头 = 底层往上发信号&lt;br&gt;橙色 = 两端共用的协议，只有一份实现" style="text;html=1;align=left;verticalAlign=top;fontSize=17;fillColor=none;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="56" y="826" width="560" height="126" as="geometry" />
        </mxCell>
        <mxCell id="a-note" value="&lt;b&gt;一句话&lt;/b&gt;&lt;br&gt;人站在摄像头前，系统认出他是谁，然后记一笔考勤。&lt;br&gt;客户端只管采集和显示，服务端承担全部判断。" style="text;html=1;align=left;verticalAlign=top;fontSize=17;fillColor=none;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="672" y="840" width="910" height="112" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-journey" name="一帧画面的旅程">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1637" pageHeight="1156" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="b-title" value="一帧画面的旅程 —— 19 步" style="text;html=1;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="56" y="28" width="980" height="42" as="geometry" />
        </mxCell>
        <mxCell id="b-legend" value="蓝 = 客户端　绿 = 服务端　橙 = 两端共用" style="text;html=1;fontSize=17;align=left;verticalAlign=middle;fontColor=#666666;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="56" y="73" width="700" height="34" as="geometry" />
        </mxCell>

        <mxCell id="b-s1" value="1. 摄像头读一帧&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;cv::Mat（BGR）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="56" y="126" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b-s2" value="2. 水平镜像&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;cv::Mat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="357" y="126" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b-s3" value="3. 本地检测画绿框&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;框坐标列表&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="658" y="126" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b-s4" value="4. 刷新预览和计数&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;QImage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="959" y="126" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b-s5" value="5. 压缩成 JPEG&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;QByteArray&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="1260" y="126" width="280" height="78" as="geometry" />
        </mxCell>

        <mxCell id="b-s6" value="6. 加 4 字节长度前缀&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;带长度头的字节&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="56" y="294" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b-s7" value="7. 写进 socket 发出去&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;TCP 字节流&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="357" y="294" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b-s8" value="8. 缓冲收到的字节&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;可能只到一半&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="658" y="294" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b-s9" value="9. 切出一整帧&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;一条完整消息&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="959" y="294" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b-s10" value="10. 发信号往上报告&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;（谁发的，内容）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="1260" y="294" width="280" height="78" as="geometry" />
        </mxCell>

        <mxCell id="b-s11" value="11. 判断是不是图像帧&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;QByteArray&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="56" y="462" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b-s12" value="12. 解码 JPEG&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;cv::Mat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="357" y="462" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b-s13" value="13. YuNet 检测人脸&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;N × 15 的数字表&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="658" y="462" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b-s14" value="14. 对齐并提取特征&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;1 × 128 浮点数&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="959" y="462" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b-s15" value="15. 和历史模板比对&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;相似度数值&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="1260" y="462" width="280" height="78" as="geometry" />
        </mxCell>

        <mxCell id="b-s16" value="16. 状态变了才继续&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;写一行日志&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="56" y="630" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b-s17" value="17. 写考勤（120 秒限流）&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;SQLite 一行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="357" y="630" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b-s18" value="18. 组装结果回传&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;RESULT 消息&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="658" y="630" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b-s19" value="19. 客户端显示结果&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;QString&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="959" y="630" width="280" height="78" as="geometry" />
        </mxCell>

        <mxCell id="b-e1" style="endArrow=block;html=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s1" target="b-s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e2" style="endArrow=block;html=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s2" target="b-s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e3" style="endArrow=block;html=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s3" target="b-s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e4" style="endArrow=block;html=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s4" target="b-s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e5" style="endArrow=block;html=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s5" target="b-s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e6" style="endArrow=block;html=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s6" target="b-s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e7" style="endArrow=block;html=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s7" target="b-s8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e8" style="endArrow=block;html=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s8" target="b-s9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e9" style="endArrow=block;html=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s9" target="b-s10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e10" style="endArrow=block;html=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s10" target="b-s11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e11" style="endArrow=block;html=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s11" target="b-s12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e12" style="endArrow=block;html=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s12" target="b-s13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e13" style="endArrow=block;html=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s13" target="b-s14"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e14" style="endArrow=block;html=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s14" target="b-s15"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e15" style="endArrow=block;html=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s15" target="b-s16"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e16" style="endArrow=block;html=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s16" target="b-s17"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e17" style="endArrow=block;html=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s17" target="b-s18"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b-e18" style="endArrow=block;html=1;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="b-s18" target="b-s19"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="b-note" value="&lt;b&gt;三个频率要分清&lt;/b&gt;&lt;br&gt;33 毫秒：读摄像头、刷预览（人眼流畅的下限）&lt;br&gt;100 毫秒：本地检测画框（神经网络每帧跑会卡界面）&lt;br&gt;500 毫秒：上传给服务端（带宽吃不消，人脸半秒内不会变）" style="text;html=1;align=left;verticalAlign=top;fontSize=17;fillColor=none;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="56" y="784" width="1120" height="126" as="geometry" />
        </mxCell>
        <mxCell id="b-note2" value="&lt;b&gt;两个卡点&lt;/b&gt;&lt;br&gt;第 6 步和第 9 步是同一份分帧规则，两端各调一次，所以它必须放在 common 里。&lt;br&gt;第 15 步的判断阈值是 0.363，超过就认定是同一个人。" style="text;html=1;align=left;verticalAlign=top;fontSize=17;fillColor=none;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="56" y="952" width="1120" height="112" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-class-client" name="类图 · 客户端">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1637" pageHeight="1156" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c-title" value="类图 · 客户端（有下划线的名字是成员变量，加号公有、减号私有）" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="42" y="28" width="1260" height="42" as="geometry" /></mxCell>
        <mxCell id="c-MainWindow" value="&lt;b&gt;MainWindow : QMainWindow&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;- cameraPreview_ : QLabel*&lt;br&gt;- statusLabel_ : QLabel*&lt;br&gt;- identityLabel_ : QLabel*&lt;br&gt;- resultLabel_ : QLabel*&lt;br&gt;- startButton_ : QPushButton*&lt;br&gt;- stopButton_ : QPushButton*&lt;br&gt;────────────&lt;br&gt;+ setStatusText(QString)&lt;br&gt;+ setFaceCount(int)&lt;br&gt;+ setResultText(QString)&lt;br&gt;+ setCameraRunning(bool)&lt;br&gt;+ showPreviewImage(QImage)&lt;br&gt;+ resetPreview()&lt;br&gt;────────────&lt;br&gt;信号 startCameraRequested()&lt;br&gt;信号 stopCameraRequested()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="42" y="112" width="350" height="420" as="geometry" /></mxCell>
        <mxCell id="c-AttendanceController" value="&lt;b&gt;AttendanceController : QObject&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;- window_ : MainWindow&amp;amp;&lt;br&gt;- camera_ : CameraController&amp;amp;&lt;br&gt;- faceDetector_ : FaceDetector&amp;amp;&lt;br&gt;- networkClient_ : NetworkClient&amp;amp;&lt;br&gt;- previewTimer_ : QTimer&lt;br&gt;- detectionClock_ : QElapsedTimer&lt;br&gt;- frameSendClock_ : QElapsedTimer&lt;br&gt;- detectedFaces_ : vector&lt;cv::Rect&gt;&lt;br&gt;────────────&lt;br&gt;+ startCamera()&lt;br&gt;+ stopCamera()&lt;br&gt;槽 processFrame()&lt;br&gt;槽 onNetworkConnected()&lt;br&gt;槽 onNetworkError(QString)&lt;br&gt;槽 onServerMessage(QByteArray)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="462" y="112" width="350" height="490" as="geometry" /></mxCell>
        <mxCell id="c-FaceDetector" value="&lt;b&gt;FaceDetector&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;- detector_ :&lt;br&gt;cv::Ptr&lt;cv::FaceDetectorYN&gt;&lt;br&gt;────────────&lt;br&gt;+ load(string) : bool&lt;br&gt;+ detect(cv::Mat&amp;amp;,&lt;br&gt;vector&lt;cv::Rect&gt;&amp;amp;) : bool&lt;br&gt;+ empty() : bool" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="896" y="112" width="322" height="266" as="geometry" /></mxCell>
        <mxCell id="c-FrameProcessor" value="&lt;b&gt;FrameProcessor&lt;/b&gt;&lt;br&gt;&lt;i&gt;工具类，全是静态方法&lt;/i&gt;&lt;br&gt;────────────&lt;br&gt;+ {static} mirror(cv::Mat)&lt;br&gt;+ {static} toGray(cv::Mat)&lt;br&gt;+ {static} toPreviewImage(&lt;br&gt;&amp;nbsp;&amp;nbsp;cv::Mat, vector&lt;cv::Rect&gt;)&lt;br&gt;+ {static} encodeJpeg(&lt;br&gt;&amp;nbsp;&amp;nbsp;QImage, int) : QByteArray" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="896" y="434" width="322" height="266" as="geometry" /></mxCell>
        <mxCell id="c-CameraController" value="&lt;b&gt;CameraController : QObject&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;- capture_ : cv::VideoCapture&lt;br&gt;────────────&lt;br&gt;+ open(int = 0) : bool&lt;br&gt;+ read(cv::Mat&amp;amp;) : bool&lt;br&gt;+ release()&lt;br&gt;+ isOpened() : bool&lt;br&gt;────────────&lt;br&gt;+ ~CameraController()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="42" y="588" width="350" height="280" as="geometry" /></mxCell>
        <mxCell id="c-NetworkClient" value="&lt;b&gt;NetworkClient : QObject&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;- socket_ : QTcpSocket&lt;br&gt;- receiveBuffer_ : QByteArray&lt;br&gt;- host_ : QString&lt;br&gt;- port_ : quint16&lt;br&gt;- reconnectTimer_ : QTimer&lt;br&gt;────────────&lt;br&gt;+ connectToServer(QString, quint16)&lt;br&gt;+ sendPayload(QByteArray) : qint64&lt;br&gt;+ isConnected() : bool&lt;br&gt;- startReconnectTimer()&lt;br&gt;槽 onReadyRead()&lt;br&gt;槽 onReconnectTimeout()&lt;br&gt;────────────&lt;br&gt;信号 connected()&lt;br&gt;信号 disconnected()&lt;br&gt;信号 connectionError(QString)&lt;br&gt;信号 messageReceived(QByteArray)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1260" y="112" width="336" height="462" as="geometry" /></mxCell>
        <mxCell id="c-FrameProtocol" value="&lt;b&gt;FrameProtocol&lt;/b&gt;&lt;br&gt;&lt;i&gt;工具类，两端共用&lt;/i&gt;&lt;br&gt;────────────&lt;br&gt;+ {static} pack(QByteArray)&lt;br&gt;+ {static} takeFrame(&lt;br&gt;&amp;nbsp;&amp;nbsp;QByteArray&amp;amp;, QByteArray&amp;amp;)&lt;br&gt;────────────────&lt;br&gt;enum FrameResult {&lt;br&gt;&amp;nbsp;&amp;nbsp;Complete, Incomplete, Invalid }" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1260" y="630" width="336" height="252" as="geometry" /></mxCell>
        <mxCell id="c-e1" value="持有引用 window_" style="endArrow=none;startArrow=diamondThin;startFill=0;html=1;strokeColor=#6c8ebf;fontSize=17;fontColor=#666666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="c-AttendanceController" target="c-MainWindow"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c-e2" value="持有引用 camera_" style="endArrow=none;startArrow=diamondThin;startFill=0;html=1;strokeColor=#6c8ebf;fontSize=17;fontColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="c-AttendanceController" target="c-CameraController"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c-e3" value="持有引用 faceDetector_" style="endArrow=none;startArrow=diamondThin;startFill=0;html=1;strokeColor=#6c8ebf;fontSize=17;fontColor=#666666;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="c-AttendanceController" target="c-FaceDetector"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c-e4" value="持有引用 networkClient_" style="endArrow=none;startArrow=diamondThin;startFill=0;html=1;strokeColor=#6c8ebf;fontSize=17;fontColor=#666666;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="c-AttendanceController" target="c-NetworkClient"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c-e5" value="调用静态方法" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontSize=17;fontColor=#666666;strokeWidth=3" edge="1" parent="1" source="c-AttendanceController" target="c-FrameProcessor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c-e6" value="调用 pack / takeFrame" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontSize=17;fontColor=#666666;strokeWidth=3" edge="1" parent="1" source="c-NetworkClient" target="c-FrameProtocol"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c-e7" value="信号 startCameraRequested" style="endArrow=open;dashed=1;html=1;strokeColor=#d79b00;fontSize=17;fontColor=#d79b00;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="c-MainWindow" target="c-AttendanceController"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c-e8" value="信号 messageReceived" style="endArrow=open;dashed=1;html=1;strokeColor=#d79b00;fontSize=17;fontColor=#d79b00;strokeWidth=3" edge="1" parent="1" source="c-NetworkClient" target="c-AttendanceController"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c-note" value="&lt;b&gt;怎么看这张图&lt;/b&gt;&lt;br&gt;&lt;br&gt;菱形箭头 = 谁持有谁的引用（构造时传进来的那几个 &amp;quot;&amp;amp;&amp;quot;）&lt;br&gt;橙色虚线 = 往上发信号，箭头指向接收方&lt;br&gt;灰色虚线 = 调用静态方法，不持有对象&lt;br&gt;&lt;br&gt;注意 AttendanceController 是唯一一个认识所有人的类，其他类互相不认识。" style="text;html=1;align=left;verticalAlign=top;fontSize=17;fillColor=none;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="42" y="910" width="1120" height="196" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-class-server" name="类图 · 服务端">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1637" pageHeight="1540" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d-title" value="类图 · 服务端" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="42" y="28" width="840" height="42" as="geometry" /></mxCell>
        <mxCell id="d-ServerWindow" value="&lt;b&gt;ServerWindow : QMainWindow&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;- statusView_ : QPlainTextEdit*&lt;br&gt;- employeeCountLabel_ : QLabel*&lt;br&gt;- employeeNoEdit_ : QLineEdit*&lt;br&gt;- nameEdit_ : QLineEdit*&lt;br&gt;- departmentEdit_ : QLineEdit*&lt;br&gt;- employeeList_ : QListWidget*&lt;br&gt;- addButton_ / refreshButton_&lt;br&gt;&amp;nbsp;&amp;nbsp;/ deleteButton_ / updateButton_&lt;br&gt;&amp;nbsp;&amp;nbsp;/ registerButton_&lt;br&gt;────────────&lt;br&gt;+ setStatusText / appendStatusText&lt;br&gt;+ setEmployeeCount(int)&lt;br&gt;+ setEmployees(QList&lt;Employee&gt;)&lt;br&gt;+ eventFilter(QObject*, QEvent*)&lt;br&gt;────────────&lt;br&gt;信号 addEmployeeRequested(...)&lt;br&gt;信号 refreshEmployeesRequested()&lt;br&gt;信号 deleteEmployeeRequested(qint64)&lt;br&gt;信号 updateEmployeeRequested(...)&lt;br&gt;信号 registerFaceRequested(qint64)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="42" y="112" width="350" height="504" as="geometry" /></mxCell>
        <mxCell id="d-ServerController" value="&lt;b&gt;ServerController : QObject&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;- server_ : Server&amp;amp;&lt;br&gt;- window_ : ServerWindow&amp;amp;&lt;br&gt;- database_ : DatabaseManager&amp;amp;&lt;br&gt;- employeeRepository_ : EmployeeRepository&lt;br&gt;- faceEngine_ : FaceEngine&lt;br&gt;- faceTemplateRepository_&lt;br&gt;- attendanceRepository_&lt;br&gt;- templates_ : QList&lt;FaceTemplate&gt;&lt;br&gt;- lastEmbedding_ : cv::Mat&lt;br&gt;- lastResult_ : FrameResult&lt;br&gt;────────────&lt;br&gt;+ initializeDatabase() : bool&lt;br&gt;+ initializeVision() : bool&lt;br&gt;+ loadEmployees() / loadTemplates()&lt;br&gt;- recognize(cv::Mat) : FrameResult&lt;br&gt;- recordAttendance(qint64, double)&lt;br&gt;- sendResult(...)&lt;br&gt;槽 onMessageReceived / onAddEmployee&lt;br&gt;&amp;nbsp;&amp;nbsp;/ onDeleteEmployee / onUpdateEmployee&lt;br&gt;&amp;nbsp;&amp;nbsp;/ onRegisterFace ...&lt;br&gt;────────────&lt;br&gt;struct FrameResult { hasFace,&lt;br&gt;&amp;nbsp;&amp;nbsp;matched, employeeId, score,&lt;br&gt;&amp;nbsp;&amp;nbsp;name, text }" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="434" y="112" width="350" height="658" as="geometry" /></mxCell>
        <mxCell id="d-Server" value="&lt;b&gt;Server : QObject&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;- server_ : QTcpServer&lt;br&gt;- connections_ :&lt;br&gt;&amp;nbsp;&amp;nbsp;QList&lt;ClientConnection*&gt;&lt;br&gt;────────────&lt;br&gt;+ listen(QHostAddress, quint16)&lt;br&gt;+ close()&lt;br&gt;+ sendToPeer(QString, QByteArray)&lt;br&gt;槽 onNewConnection()&lt;br&gt;────────────&lt;br&gt;信号 listeningStarted(QString)&lt;br&gt;信号 listeningError(QString)&lt;br&gt;信号 clientConnected(QString)&lt;br&gt;信号 clientDisconnected(QString)&lt;br&gt;信号 messageReceived(QString,&lt;br&gt;&amp;nbsp;&amp;nbsp;QByteArray)&lt;br&gt;信号 clientError(QString)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="826" y="112" width="350" height="504" as="geometry" /></mxCell>
        <mxCell id="d-ClientConnection" value="&lt;b&gt;ClientConnection : QObject&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;- socket_ : QTcpSocket*&lt;br&gt;- receiveBuffer_ : QByteArray&lt;br&gt;────────────&lt;br&gt;+ peerName() : QString&lt;br&gt;+ sendPayload(QByteArray) : qint64&lt;br&gt;- processFrames()&lt;br&gt;槽 onReadyRead()&lt;br&gt;槽 onDisconnected()&lt;br&gt;槽 onSocketError()&lt;br&gt;────────────&lt;br&gt;信号 messageReceived(QByteArray)&lt;br&gt;信号 disconnected(QString)&lt;br&gt;信号 errorOccurred(QString)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1218" y="112" width="350" height="462" as="geometry" /></mxCell>
        <mxCell id="d-DatabaseManager" value="&lt;b&gt;DatabaseManager&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;- connectionName_ : QString&lt;br&gt;- lastError_ : QString&lt;br&gt;────────────&lt;br&gt;+ open(QString) : bool&lt;br&gt;+ initializeSchema() : bool&lt;br&gt;+ close() / isOpen()&lt;br&gt;+ database() : QSqlDatabase&lt;br&gt;+ lastError() : QString&lt;br&gt;────────────&lt;br&gt;+ ~DatabaseManager()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="42" y="686" width="350" height="308" as="geometry" /></mxCell>
        <mxCell id="d-EmployeeRepository" value="&lt;b&gt;EmployeeRepository&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;- databaseManager_ :&lt;br&gt;&amp;nbsp;&amp;nbsp;DatabaseManager&amp;amp;&lt;br&gt;- lastError_ : QString&lt;br&gt;────────────&lt;br&gt;+ addEmployee(...)&lt;br&gt;+ updateEmployee(qint64, ...)&lt;br&gt;+ removeById(qint64)&lt;br&gt;+ findByEmployeeNo(QString,&lt;br&gt;&amp;nbsp;&amp;nbsp;Employee&amp;amp;) : bool&lt;br&gt;+ findAll(QList&lt;Employee&gt;&amp;amp;) : bool&lt;br&gt;+ lastError()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="434" y="826" width="350" height="350" as="geometry" /></mxCell>
        <mxCell id="d-FaceTemplateRepository" value="&lt;b&gt;FaceTemplateRepository&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;- databaseManager_ :&lt;br&gt;&amp;nbsp;&amp;nbsp;DatabaseManager&amp;amp;&lt;br&gt;- lastError_ : QString&lt;br&gt;────────────&lt;br&gt;+ saveTemplate(qint64,&lt;br&gt;&amp;nbsp;&amp;nbsp;QByteArray)&lt;br&gt;+ findAll(QList&lt;FaceTemplate&gt;&amp;amp;)&lt;br&gt;+ lastError()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="826" y="672" width="350" height="266" as="geometry" /></mxCell>
        <mxCell id="d-AttendanceRepository" value="&lt;b&gt;AttendanceRepository&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;- databaseManager_ :&lt;br&gt;&amp;nbsp;&amp;nbsp;DatabaseManager&amp;amp;&lt;br&gt;- lastError_ : QString&lt;br&gt;────────────&lt;br&gt;+ addRecord(qint64, QString,&lt;br&gt;&amp;nbsp;&amp;nbsp;double)&lt;br&gt;+ hasRecordWithin(qint64,&lt;br&gt;&amp;nbsp;&amp;nbsp;int, bool&amp;amp;)&lt;br&gt;+ lastError()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1218" y="658" width="350" height="266" as="geometry" /></mxCell>
        <mxCell id="d-FaceEngine" value="&lt;b&gt;FaceEngine&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;+ kMatchThreshold = 0.363&lt;br&gt;- detector_ :&lt;br&gt;&amp;nbsp;&amp;nbsp;cv::Ptr&lt;cv::FaceDetectorYN&gt;&lt;br&gt;- recognizer_ :&lt;br&gt;&amp;nbsp;&amp;nbsp;cv::Ptr&lt;cv::FaceRecognizerSF&gt;&lt;br&gt;- lastError_ : QString&lt;br&gt;────────────&lt;br&gt;+ load(QString, QString) : bool&lt;br&gt;+ analyze(cv::Mat, vector&lt;Face&gt;&amp;amp;)&lt;br&gt;+ analyzeJpeg(QByteArray, ...)&lt;br&gt;+ similarity(cv::Mat, cv::Mat)&lt;br&gt;+ isLoaded() / lastError()&lt;br&gt;+ {static} toBytes(cv::Mat)&lt;br&gt;+ {static} fromBytes(QByteArray)&lt;br&gt;────────────&lt;br&gt;struct Face { box : cv::Rect,&lt;br&gt;&amp;nbsp;&amp;nbsp;embedding : cv::Mat,&lt;br&gt;&amp;nbsp;&amp;nbsp;score : float }" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="826" y="994" width="350" height="462" as="geometry" /></mxCell>
        <mxCell id="d-Employee" value="&lt;b&gt;Employee&lt;/b&gt; &lt;i&gt;(struct)&lt;/i&gt;&lt;br&gt;────────────&lt;br&gt;+ id : qint64&lt;br&gt;+ employeeNo : QString&lt;br&gt;+ name : QString&lt;br&gt;+ department : QString&lt;br&gt;+ createdAt : QString" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="42" y="1050" width="350" height="238" as="geometry" /></mxCell>
        <mxCell id="d-FaceTemplate" value="&lt;b&gt;FaceTemplate&lt;/b&gt; &lt;i&gt;(struct)&lt;/i&gt;&lt;br&gt;────────────&lt;br&gt;+ employeeId : qint64&lt;br&gt;+ employeeNo : QString&lt;br&gt;+ name : QString&lt;br&gt;+ featureData : QByteArray&lt;br&gt;&amp;nbsp;&amp;nbsp;(512 字节 = 128 个 float)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="434" y="1218" width="350" height="238" as="geometry" /></mxCell>
        <mxCell id="d-FrameProtocol" value="&lt;b&gt;FrameProtocol&lt;/b&gt; &lt;i&gt;(两端共用)&lt;/i&gt;&lt;br&gt;────────────&lt;br&gt;+ {static} pack(QByteArray)&lt;br&gt;+ {static} takeFrame(&lt;br&gt;&amp;nbsp;&amp;nbsp;QByteArray&amp;amp;, QByteArray&amp;amp;)&lt;br&gt;────────────&lt;br&gt;enum FrameResult {&lt;br&gt;&amp;nbsp;&amp;nbsp;Complete, Incomplete, Invalid }" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=17;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;strokeWidth=2" vertex="1" parent="1"><mxGeometry x="1218" y="994" width="350" height="266" as="geometry" /></mxCell>
