        <mxCell id="d-e3" value="持有引用 database_" style="endArrow=none;startArrow=diamondThin;startFill=0;html=1;strokeColor=#82b366;fontSize=17;fontColor=#666666;exitX=0;exitY=0.95;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;strokeWidth=3" edge="1" parent="1" source="d-ServerController" target="d-DatabaseManager"><mxGeometry relative="1" as="geometry" /></mxCell>
